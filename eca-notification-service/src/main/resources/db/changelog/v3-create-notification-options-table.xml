<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/v3-create-notification-options-table.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="create_notification_options_table" author="roman.batygin@mail.ru" context="schema">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notification_options"/>
            </not>
        </preConditions>
        <createTable tableName="notification_options">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email_enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="web_push_enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="created" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="_user" type="varchar(255)">
                <constraints unique="true" uniqueConstraintName="notification_options_user_unique_idx" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create_notification_event_options" author="roman.batygin@mail.ru" context="schema">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notification_options"/>
            <not>
                <tableExists tableName="notification_event_options"/>
            </not>
        </preConditions>
        <createTable tableName="notification_event_options">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="web_push_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="email_supported" type="boolean" defaultValueBoolean="false"/>
            <column name="web_push_supported" type="boolean" defaultValueBoolean="false"/>
            <column name="notification_options_id" type="bigint">
                <constraints foreignKeyName="fk_notification_event_options_notification_options_id"
                             referencedTableName="notification_options"
                             referencedColumnNames="id" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="add_notification_options_id_event_type_unique_idx" author="roman.batygin@mail.ru" context="schema">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notification_event_options"/>
            <columnExists tableName="notification_event_options" columnName="notification_options_id"/>
            <columnExists tableName="notification_event_options" columnName="event_type"/>
        </preConditions>
        <addUniqueConstraint tableName="notification_event_options"
                             columnNames="notification_options_id, event_type"
                             constraintName="notification_options_id_event_type_unique_idx"/>
    </changeSet>

    <changeSet id="rename_notification_table" author="roman.batygin@mail.ru" context="schema">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="notification"/>
            <not>
                <tableExists tableName="user_notification"/>
            </not>
        </preConditions>
        <renameTable oldTableName="notification" newTableName="user_notification"/>
    </changeSet>
</databaseChangeLog>
