<?xml version="1.1" encoding="utf-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/v23-insert-change-email-confirm-new-email-template.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="insert_revoke_change_email_request_url_template_parameter" author="roman.batygin@mail.ru" context="data">
        <insert tableName="template_parameter">
            <column name="id" valueComputed="nextval('hibernate_sequence')"/>
            <column name="created" valueDate="now()"/>
            <column name="parameter_name" value="revokeChangeEmailRequestUrl"/>
            <column name="description" value="Ссылка для отмены изменения email"/>
        </insert>
    </changeSet>

    <changeSet id="insert_revoke_change_email_request_url_to_change_email_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="templates_parameters">
            <column name="template_id" valueComputed="(select id from template where template_code = 'CHANGE_EMAIL')"/>
            <column name="param_id" valueComputed="(select id from template_parameter where parameter_name = 'revokeChangeEmailRequestUrl')"/>
        </insert>
    </changeSet>

    <changeSet id="delete_confirmation_code_from_change_email_templates_parameters" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(*) from templates_parameters where template_id = (select id from template where template_code = 'CHANGE_EMAIL') and param_id = (select id from template_parameter where parameter_name = 'confirmationCode')</sqlCheck>
        </preConditions>
        <delete tableName="templates_parameters">
            <where>template_id = (select id from template where template_code = 'CHANGE_EMAIL') and param_id = (select id from template_parameter where parameter_name = 'confirmationCode')</where>
        </delete>
    </changeSet>

    <changeSet id="delete_validity_hours_from_change_email_templates_parameters" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(*) from templates_parameters where template_id = (select id from template where template_code = 'CHANGE_EMAIL') and param_id = (select id from template_parameter where parameter_name = 'validityHours')</sqlCheck>
        </preConditions>
        <delete tableName="templates_parameters">
            <where>template_id = (select id from template where template_code = 'CHANGE_EMAIL') and param_id = (select id from template_parameter where parameter_name = 'validityHours')</where>
        </delete>
    </changeSet>

    <changeSet id="update_change_email_subject_2" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="template"/>
            <sqlCheck expectedResult="1">select count(*) from template where template_code = 'CHANGE_EMAIL'</sqlCheck>
        </preConditions>
        <update tableName="template">
            <column name="description" value="Уведомление на старую почту о запросе изменения Email в личном кабинете Eca - service"/>
            <column name="template_subject" value="Уведомление о запросе изменения Email в личном кабинете Eca - service"/>
            <where>template_code = 'CHANGE_EMAIL'</where>
        </update>
    </changeSet>

    <changeSet id="insert_change_email_confirm_new_email_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="template">
            <column name="id" valueComputed="nextval('hibernate_sequence')"/>
            <column name="created" valueDate="now()"/>
            <column name="template_code" value="CHANGE_EMAIL_CONFIRM_NEW_EMAIL"/>
            <column name="description" value="Сообщение с подтверждением изменения Email в личном кабинете Eca - service"/>
            <column name="template_subject" value="Подтверждение изменения Email в личном кабинете Eca - service"/>
        </insert>
    </changeSet>

    <changeSet id="update_change_email_confirm_new_email_template_body" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="template"/>
            <sqlCheck expectedResult="1">select count(*) from template where template_code = 'CHANGE_EMAIL_CONFIRM_NEW_EMAIL'</sqlCheck>
        </preConditions>
        <update tableName="template">
            <column name="template_body" valueClobFile="templates/change-email-confirm-new-email-template.html"/>
            <where>template_code = 'CHANGE_EMAIL_CONFIRM_NEW_EMAIL'</where>
        </update>
    </changeSet>

    <changeSet id="insert_confirmation_code_to_change_email_confirm_new_email_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="templates_parameters">
            <column name="template_id" valueComputed="(select id from template where template_code = 'CHANGE_EMAIL_CONFIRM_NEW_EMAIL')"/>
            <column name="param_id" valueComputed="(select id from template_parameter where parameter_name = 'confirmationCode')"/>
        </insert>
    </changeSet>

    <changeSet id="insert_validity_minutes_to_change_email_confirm_new_email_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="templates_parameters">
            <column name="template_id" valueComputed="(select id from template where template_code = 'CHANGE_EMAIL_CONFIRM_NEW_EMAIL')"/>
            <column name="param_id" valueComputed="(select id from template_parameter where parameter_name = 'validityMinutes')"/>
        </insert>
    </changeSet>

    <changeSet id="insert_change_email_new_email_confirmed_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="template">
            <column name="id" valueComputed="nextval('hibernate_sequence')"/>
            <column name="created" valueDate="now()"/>
            <column name="template_code" value="EMAIL_CHANGED_NEW_EMAIL_CONFIRMED"/>
            <column name="description" value="Сообщение с успешным подтверждением изменения Email в личном кабинете Eca - service"/>
            <column name="template_subject" value="Подтверждено изменение Email в личном кабинете Eca - service"/>
        </insert>
    </changeSet>

    <changeSet id="update_change_email_new_email_confirmed_template_body" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="template"/>
            <sqlCheck expectedResult="1">select count(*) from template where template_code = 'EMAIL_CHANGED_NEW_EMAIL_CONFIRMED'</sqlCheck>
        </preConditions>
        <update tableName="template">
            <column name="template_body" valueClobFile="templates/change-email-new-email-confirmed-template.html"/>
            <where>template_code = 'EMAIL_CHANGED_NEW_EMAIL_CONFIRMED'</where>
        </update>
    </changeSet>

    <changeSet id="insert_new_email_to_email_changed_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="templates_parameters">
            <column name="template_id" valueComputed="(select id from template where template_code = 'EMAIL_CHANGED')"/>
            <column name="param_id" valueComputed="(select id from template_parameter where parameter_name = 'newEmail')"/>
        </insert>
    </changeSet>

    <changeSet id="update_email_changed_subject" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="template"/>
            <sqlCheck expectedResult="1">select count(*) from template where template_code = 'EMAIL_CHANGED'</sqlCheck>
        </preConditions>
        <update tableName="template">
            <column name="description" value="Уведомление на старую почту об успешном изменении Email в личном кабинете Eca - service"/>
            <column name="template_subject" value="Уведомление об успешном изменении Email в личном кабинете Eca - service"/>
            <where>template_code = 'EMAIL_CHANGED'</where>
        </update>
    </changeSet>
</databaseChangeLog>
