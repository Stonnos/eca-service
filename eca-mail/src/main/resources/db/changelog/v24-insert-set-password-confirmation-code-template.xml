<?xml version="1.1" encoding="utf-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/v24-insert-set-password-confirmation-code-template.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="insert_set_password_confirmation_code_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="template">
            <column name="id" valueComputed="nextval('hibernate_sequence')"/>
            <column name="created" valueDate="now()"/>
            <column name="template_code" value="SET_PASSWORD_CONFIRMATION_CODE"/>
            <column name="description" value="Сообщение с кодом подтверждения для установки постоянного пароля"/>
            <column name="template_subject" value="Код подтверждения для установки постоянного пароля"/>
        </insert>
    </changeSet>

    <changeSet id="update_set_password_confirmation_code_template_body" author="roman.batygin@mail.ru" context="data">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="template"/>
            <sqlCheck expectedResult="1">select count(*) from template where template_code = 'SET_PASSWORD_CONFIRMATION_CODE'</sqlCheck>
        </preConditions>
        <update tableName="template">
            <column name="template_body" valueClobFile="templates/set-password-confirmation-code-template.html"/>
            <where>template_code = 'SET_PASSWORD_CONFIRMATION_CODE'</where>
        </update>
    </changeSet>

    <changeSet id="insert_confirmation_code_to_set_password_confirmation_code_template" author="roman.batygin@mail.ru" context="data">
        <insert tableName="templates_parameters">
            <column name="template_id" valueComputed="(select id from template where template_code = 'SET_PASSWORD_CONFIRMATION_CODE')"/>
            <column name="param_id" valueComputed="(select id from template_parameter where parameter_name = 'confirmationCode')"/>
        </insert>
    </changeSet>
</databaseChangeLog>
